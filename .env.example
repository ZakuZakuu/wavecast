# The Phase 0/1 mock runtime works without any credentials.
WAVECAST_API_HOST=127.0.0.1
WAVECAST_API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
WAVECAST_DATABASE_URL=
# Server-side generation guardrails (checked before any proposal provider call).
WAVECAST_GUEST_PROGRAM_LIMIT=3
WAVECAST_AUTH_DAILY_PROGRAM_LIMIT=20
WAVECAST_GLOBAL_DAILY_PROGRAM_LIMIT=100
# Optional direct PostgreSQL URL for Better Auth. If omitted, the Web app
# derives it from WAVECAST_DATABASE_URL and normalizes postgresql+asyncpg://.
BETTER_AUTH_DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BETTER_AUTH_SCHEMA=auth
RESEND_API_KEY=
WAVECAST_EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WAVECAST_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
WAVECAST_AUTH_ISSUER=http://localhost:3000
WAVECAST_AUTH_AUDIENCE=http://localhost:3000
WAVECAST_AUDIO_ROOT=.wavecast-data/audio
# Optional Railway Persistent Volume fallback when WAVECAST_AUDIO_ROOT is unset.
RAILWAY_VOLUME_MOUNT_PATH=
# Set this only for the optional Postgres integration suite.
WAVECAST_TEST_DATABASE_URL=

# Phase 2 provider adapters. Mock mode remains the default and needs no credentials.
WAVECAST_PROVIDER_MODE=mock
# Home recommendation inference is gated independently from episode providers.
# deepseek requires DEEPSEEK_API_KEY but does not switch sibling capabilities live.
WAVECAST_RECOMMENDATION_PLANNER=deterministic
# Capability-level overrides. "inherit" follows WAVECAST_PROVIDER_MODE.
# Keep the global mode mock in production while enabling these one boundary at a time.
WAVECAST_PROPOSAL_PLANNER=inherit
WAVECAST_MUSIC_PROVIDER=inherit
WAVECAST_FAST_START_PROVIDER=inherit
WAVECAST_RESEARCH_PROVIDER=inherit
WAVECAST_CURATOR_PROVIDER=inherit
WAVECAST_WRITER_PROVIDER=inherit
WAVECAST_TTS_PROVIDER=inherit
# on | off (default off): verify catalog tracks are playable before the Curator chooses (ADR 0022).
WAVECAST_CATALOG_POOL=off
# on | off (default on): size the programme route (tracks/chapters) from the requested tier
# (short about 35 minutes, long about an hour) and end it on the track nearest that budget.
WAVECAST_DURATION_SCALING=on
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Search adapters retain their short 20-second timeout. These optional values only bound
# structured DeepSeek synthesis; code defaults apply when the variables are absent.
DEEPSEEK_TIMEOUT_SECONDS=20
# DEEP profile/background Curator budget; FAST/BALANCED keep their own limits.
DEEPSEEK_DEEP_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_DEEP_MAX_OUTPUT_TOKENS=12288
DEEPSEEK_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
# Phase 4.2 Audius catalog. Mock mode and CI remain credential-free. Live Audius
# access uses the app API key for catalog requests and keeps the backend bearer
# token server-side; neither credential is sent to browser playback.
AUDIUS_BASE_URL=https://api.audius.co/v1
AUDIUS_API_KEY=
AUDIUS_BEARER_TOKEN=
# Optional Phase 4.3 catalog sidecars. These are never required for mock mode/CI.
NETEASE_MUSIC_API_BASE_URL=
QQ_MUSIC_API_BASE_URL=
# Optional Phase 4.4 narration. Mock mode remains credential-free.
MINIMAX_API_KEY=
# WaveCast defaults to the Mainland China MiniMax endpoint; override this for another MiniMax region.
MINIMAX_TTS_BASE_URL=https://api.minimax.cn
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE_ID=
MINIMAX_TTS_SPEED=0.8
MINIMAX_TTS_LANGUAGE_BOOST=auto
