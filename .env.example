# The Phase 0/1 mock runtime works without any credentials.
WAVECAST_API_HOST=127.0.0.1
WAVECAST_API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
WAVECAST_DATABASE_URL=
# Set this only for the optional Postgres integration suite.
WAVECAST_TEST_DATABASE_URL=

# Phase 2 provider adapters. Mock mode remains the default and needs no credentials.
WAVECAST_PROVIDER_MODE=mock
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Search adapters retain their short 20-second timeout. These optional values only bound
# structured DeepSeek synthesis; code defaults apply when the variables are absent.
DEEPSEEK_TIMEOUT_SECONDS=20
# DEEP profile/background Curator budget; FAST/BALANCED keep their own limits.
DEEPSEEK_DEEP_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
