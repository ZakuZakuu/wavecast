{
  "name": "@wavecast/video",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "studio": "pnpm sfx && remotion studio src/index.ts",
    "sfx": "node scripts/synth-sfx.mjs",
    "typecheck": "tsc --noEmit",
    "render": "pnpm sfx && remotion render src/index.ts WaveCastDemo out/wavecast-demo.mp4 --codec=h264 --crf=18",
    "render:silent": "remotion render src/index.ts WaveCastDemoSilent out/wavecast-demo-silent.mp4 --codec=h264 --crf=18 --muted",
    "still": "remotion still src/index.ts WaveCastDemo"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "19.0.2",
    "typescript": "5.7.2"
  }
}
